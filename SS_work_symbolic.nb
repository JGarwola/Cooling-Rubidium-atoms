Cell[CellGroupData[{

Cell["Example 5: Motion-TLS coupled system", "Section",
 CellChangeTimes->{{3.9863781981926217`*^9, 
  3.9863782418782525`*^9}},ExpressionUUID->"e10eaf1a-48ec-4d0a-ba06-\
ba0ccb5e9e13"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"AnnihilationOp", "[", "n_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"n", "-", "1"}], "]"}], "]"}], ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CreationOp", "[", "n_", "]"}], ":=", 
   RowBox[{"ConjugateTranspose", "[", 
    RowBox[{"AnnihilationOp", "[", "n", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<Pauli`\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Nmot", " ", "=", " ", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"AnnihilationOp", "[", "Nmot", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"adag", "=", 
   RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mF", " ", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"2", "0"},
      {"0", "1"}
     }], "\[NoBreak]", ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]up", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"\[Sigma]", "[", "1", "]"}], "+", 
     RowBox[{"I", "*", 
      RowBox[{"\[Sigma]", "[", "2", "]"}]}]}], "2"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xh0", " ", "=", " ", 
   SqrtBox[
    RowBox[{
     RowBox[{"1", "/", "2"}], "m", "*", "\[Omega]"}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Eta]", "=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[Mu]B", "*", "xho", "*", "dB"}], "2"], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Mu]B", "->", "1"}], ",", 
       RowBox[{"dB", "->", "1"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Define", " ", "the", " ", "Hamiltonian"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hmot", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[Sigma]", "[", "0", "]"}], "\[TensorProduct]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Omega]", "*", 
       RowBox[{"(", 
        RowBox[{"adag", ".", "a"}], ")"}]}], "-", 
      RowBox[{"\[Omega]", "*", 
       FractionBox["x0", "xho"], "*", 
       RowBox[{"(", 
        RowBox[{"adag", "+", "a"}], ")"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hspin", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[CapitalDelta]", "*", 
       RowBox[{"\[Sigma]", "[", "3", "]"}]}], "+", 
      RowBox[{"\[CapitalOmega]", "*", 
       RowBox[{"\[Sigma]", "[", "1", "]"}]}]}], ")"}], "\[TensorProduct]", 
    RowBox[{"IdentityMatrix", "[", "Nmot", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hcoup", " ", "=", 
   RowBox[{"mF", "\[TensorProduct]", 
    RowBox[{"(", 
     RowBox[{"\[Eta]", "*", 
      RowBox[{"(", 
       RowBox[{"adag", "+", "a"}], ")"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Htot", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Hmot", "+", "Hspin", "+", "Hcoup"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Define", " ", "the", " ", "dissipator"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LOP", "[", "r_", "]"}], ":=", 
   RowBox[{"LindbladDissipator", "[", 
    RowBox[{
     RowBox[{
      SqrtBox["\[Gamma]up"], "*", 
      RowBox[{"\[Sigma]up", "\[TensorProduct]", 
       RowBox[{"IdentityMatrix", "[", "Nmot", "]"}]}]}], ",", "r"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LDP", "[", "r_", "]"}], ":=", 
   RowBox[{"LindbladDissipator", "[", 
    RowBox[{
     RowBox[{
      SqrtBox[
       RowBox[{"\[Gamma]\[Phi]", "/", "2"}]], "*", 
      RowBox[{
       RowBox[{"\[Sigma]", "[", "3", "]"}], "\[TensorProduct]", 
       RowBox[{"IdentityMatrix", "[", "Nmot", "]"}]}]}], ",", "r"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LC", "[", "r_", "]"}], ":=", 
   RowBox[{"LindbladDissipator", "[", 
    RowBox[{
     RowBox[{
      SqrtBox[
       RowBox[{"\[CapitalGamma]m", "*", 
        RowBox[{"(", 
         RowBox[{"n", "+", "1"}], ")"}]}]], "*", 
      RowBox[{
       RowBox[{"\[Sigma]", "[", "0", "]"}], "\[TensorProduct]", "a"}]}], ",", 
     "r"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LH", "[", "r_", "]"}], ":=", 
   RowBox[{"LindbladDissipator", "[", 
    RowBox[{
     RowBox[{
      SqrtBox[
       RowBox[{"\[CapitalGamma]m", "*", "n"}]], "*", 
      RowBox[{
       RowBox[{"\[Sigma]", "[", "0", "]"}], "\[TensorProduct]", "adag"}]}], 
     ",", "r"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
