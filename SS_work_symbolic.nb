Cell[CellGroupData[{

Cell[TextData[{
 "Compare reversible and dissipative heat ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Q", "diss"], "=", 
    RowBox[{"-", 
     RowBox[{"\[Integral]", 
      RowBox[{"dt", " ", 
       SubscriptBox["g", "ij"], 
       RowBox[{
        SuperscriptBox["d\[Lambda]", "i"], "/", "dt"}], " ", 
       RowBox[{
        SuperscriptBox["d\[Lambda]", "j"], "/", "dt"}]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"912e0377-5092-4b65-b6d1-3394f4c75052"]
}], "Subsection",
 CellChangeTimes->{{3.9841486952878156`*^9, 3.9841487733651824`*^9}, {
  3.9841502801597147`*^9, 
  3.9841502851820345`*^9}},ExpressionUUID->"dc3f9d5b-d8cd-46be-92c8-\
0042c06c55a9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ComputeCycleHeats", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ComputeCycleHeats", "[", 
    RowBox[{
    "rhoSS_", ",", "ham_", ",", "dissipatorFunc_", ",", "params_", ",", 
     "ranges_", ",", "rules_", ",", "R_", ",", "offset_", ",", 
     RowBox[{"tau_", ":", 
      RowBox[{"2", " ", "Pi"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "dRho", ",", "solveLInv", ",", "gMetric", ",", "Ai", ",", "path", ",", 
       "dPath", ",", "integrandGeo", ",", "integrandDiss", ",", "qGeo", ",", 
       "qDiss", ",", "varsX", ",", "basis"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Ai", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{"ham", ".", 
           RowBox[{"D", "[", 
            RowBox[{"rhoSS", ",", "p"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "params"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dRho", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"rhoSS", ",", "p"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "params"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"solveLInv", "[", "target_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"X", ",", "x", ",", "varsX", ",", "eqsL", ",", "solX"}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"varsX", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"x", "[", "k", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", "8"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"X", "=", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"varsX", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "*", 
              RowBox[{"gm", "[", "k", "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", "8"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"eqsL", "=", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "I"}], "*", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"ham", ".", "X"}], "-", 
                  RowBox[{"X", ".", "ham"}]}], ")"}]}], "+", 
               RowBox[{"dissipatorFunc", "[", "X", "]"}]}], "]"}], "==", 
             RowBox[{"Flatten", "[", "target", "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"solX", "=", 
           RowBox[{"Solve", "[", 
            RowBox[{"eqsL", ",", "varsX"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"solX", "===", 
             RowBox[{"{", "}"}]}], ",", "0", ",", 
            RowBox[{"X", "/.", " ", 
             RowBox[{"solX", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"gMetric", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"dRho", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ".", 
           RowBox[{"solveLInv", "[", 
            RowBox[{"dRho", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"path", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"R", "*", 
           RowBox[{"Cos", "[", "t", "]"}]}], "+", 
          RowBox[{"offset", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"R", "*", 
           RowBox[{"Sin", "[", "t", "]"}]}], "+", 
          RowBox[{"offset", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dPath", "=", 
       RowBox[{"D", "[", 
        RowBox[{"path", ",", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"integrandGeo", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Ai", "/.", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"params", "->", "path"}], "]"}]}], ")"}], ".", "dPath"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"integrandDiss", "=", 
       RowBox[{"(", 
        RowBox[{"dPath", ".", 
         RowBox[{"(", 
          RowBox[{"gMetric", "/.", " ", 
           RowBox[{"Thread", "[", 
            RowBox[{"params", "->", "path"}], "]"}]}], ")"}], ".", "dPath"}], 
        ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"qGeo", "=", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"integrandGeo", "/.", " ", "rules"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", 
           RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qDiss", "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", "tau"}], ")"}]}], "*", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{"integrandDiss", "/.", " ", "rules"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", 
            RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<--- Cycle Results (tau = \>\"", ",", "tau", ",", 
        "\"\<) ---\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Geometric Heat (Reversible): \>\"", ",", "qGeo"}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Dissipated Heat (Irreversible): \>\"", ",", "qDiss"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Net Heat: \>\"", ",", 
        RowBox[{"qGeo", "+", "qDiss"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"qGeo", ",", "qDiss"}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.984148779806883*^9, 3.9841487959604826`*^9}, 
   3.9841488731128025`*^9, {3.984148907535269*^9, 3.984148970647788*^9}, {
   3.984149069333522*^9, 3.9841490978363066`*^9}, {3.9841491736485424`*^9, 
   3.984149217498787*^9}, {3.9841496580285625`*^9, 3.9841496719223423`*^9}, {
   3.9841502103162675`*^9, 3.984150276069581*^9}, 3.984150324757411*^9, {
   3.984150376515109*^9, 3.984150396395361*^9}, {3.984151721821909*^9, 
   3.9841517308304133`*^9}, 3.9845674069668922`*^9},
 CellLabel->"In[18]:=",ExpressionUUID->"294436fd-2a9a-414c-b81a-71a8463042fd"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example 1: Rubidium atom", "Section",
 CellChangeTimes->{{3.983978426347226*^9, 
  3.9839784413115544`*^9}},ExpressionUUID->"a3856de7-d103-4a6b-b265-\
b71221807aee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]", "=", 
     RowBox[{"2", 
      RowBox[{"\[Pi]", " ", "[", 
       RowBox[{
        RowBox[{"-", "100"}], ",", "100"}], "]"}], " ", "MHz"}]}], ",", " ", 
    RowBox[{"\[CapitalOmega]", "=", 
     RowBox[{"2", 
      RowBox[{"\[Pi]", " ", "[", 
       RowBox[{"0", ",", "10"}], "]"}], " ", "MHz"}]}], ",", " ", 
    RowBox[{
     SubscriptBox["\[Gamma]", "diss"], "=", 
     RowBox[{"2", "\[Pi]", " ", "6.1", " ", "MHz"}]}], ",", " ", 
    RowBox[{
     SubscriptBox["\[Gamma]", "\[Phi]"], "=", 
     RowBox[{"1", " ", "MHz"}]}], ","}], " ", "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"H3", "=", 
     RowBox[{
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {"0", "0", 
          RowBox[{"\[CapitalOmega]1", "/", "2"}]},
         {"0", "\[CapitalDelta]1", 
          RowBox[{"\[CapitalOmega]2", "/", "2"}]},
         {
          RowBox[{"\[CapitalOmega]1", "/", "2"}], 
          RowBox[{"\[CapitalOmega]2", "/", "2"}], "\[CapitalDelta]2"}
        }], "\[NoBreak]", ")"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[CapitalOmega]1", "->", "\[CapitalOmega]"}], ",", 
        RowBox[{"\[CapitalOmega]2", "->", "\[CapitalOmega]"}], ",", " ", 
        RowBox[{"\[CapitalDelta]2", "->", "\[CapitalDelta]"}], ",", 
        RowBox[{"\[CapitalDelta]1", "->", 
         RowBox[{"\[CapitalDelta]", "/", "10"}]}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Dissipators3", "=", 
     RowBox[{"Function", "[", 
      RowBox[{"r", ",", 
       RowBox[{
        RowBox[{"\[Gamma]diss", "*", 
         RowBox[{"LindbladDissipator", "[", 
          RowBox[{
           RowBox[{"(", "\[NoBreak]", GridBox[{
              {"0", "1", "0"},
              {"0", "0", "0"},
              {"0", "0", "0"}
             }], "\[NoBreak]", ")"}], ",", "r"}], "]"}]}], "+", 
        RowBox[{"\[Gamma]diss", "*", 
         RowBox[{"LindbladDissipator", "[", 
          RowBox[{
           RowBox[{"(", "\[NoBreak]", GridBox[{
              {"0", "0", "1"},
              {"0", "0", "0"},
              {"0", "0", "0"}
             }], "\[NoBreak]", ")"}], ",", "r"}], "]"}]}], "+", 
        RowBox[{"\[Gamma]\[Phi]", "*", 
         RowBox[{"LindbladDissipator", "[", 
          RowBox[{
           RowBox[{"(", "\[NoBreak]", GridBox[{
              {"0", "0", "0"},
              {"0", "1", "0"},
              {"0", "0", 
               RowBox[{"-", "1"}]}
             }], "\[NoBreak]", ")"}], ",", "r"}], "]"}]}], "+", 
        RowBox[{"\[Gamma]\[Phi]", "*", 
         RowBox[{"LindbladDissipator", "[", 
          RowBox[{
           RowBox[{"(", "\[NoBreak]", GridBox[{
              {"1", "0", "0"},
              {"0", "0", "0"},
              {"0", "0", 
               RowBox[{"-", "1"}]}
             }], "\[NoBreak]", ")"}], ",", "r"}], "]"}]}]}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhoSS", "=", 
     RowBox[{
      RowBox[{"GetSteadyState", "[", 
       RowBox[{"H3", ",", "Dissipators3"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[CapitalOmega]1", "->", "\[CapitalOmega]"}], ",", 
        RowBox[{"\[CapitalOmega]2", "->", "\[CapitalOmega]"}], ",", " ", 
        RowBox[{"\[CapitalDelta]2", "->", "\[CapitalDelta]"}], ",", 
        RowBox[{"\[CapitalDelta]1", "->", 
         RowBox[{"\[CapitalDelta]", "/", "10"}]}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"AnalyzeGeometricHeat", "[", 
    RowBox[{"H3", ",", "rhoSS", ",", "Dissipators3", ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalDelta]", ",", "\[CapitalOmega]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[CapitalOmega]", ",", "0.1", ",", 
         RowBox[{"2", "\[Pi]", " ", "10"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", 
         RowBox[{
          RowBox[{"-", "2"}], "\[Pi]", " ", "100"}], ",", 
         RowBox[{"2", "\[Pi]", " ", "100"}]}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Gamma]diss", "->", 
        RowBox[{"2", " ", "\[Pi]", " ", "6.1"}]}], ",", 
       RowBox[{"\[Gamma]\[Phi]", "->", "1"}]}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9839770544228525`*^9, 3.9839770544398537`*^9}, 
   3.983977096699032*^9, {3.983977311280937*^9, 3.983977326023849*^9}, {
   3.9839774509634*^9, 3.983977591017495*^9}, {3.983977680993123*^9, 
   3.983977686441547*^9}, {3.983977991022808*^9, 3.9839779923396273`*^9}, {
   3.9839781991072354`*^9, 3.983978200390135*^9}, {3.9839782473353662`*^9, 
   3.9839782753428774`*^9}, {3.983978306309567*^9, 3.9839783172197914`*^9}, {
   3.9839818026716433`*^9, 3.9839818408371305`*^9}, {3.983981948456109*^9, 
   3.9839819557100325`*^9}, {3.98398213457283*^9, 3.983982254188151*^9}, {
   3.983982559612191*^9, 3.983982565986725*^9}, {3.9841412700562353`*^9, 
   3.9841413205114365`*^9}, {3.9841413694576263`*^9, 
   3.9841414330916634`*^9}, {3.9841415234426737`*^9, 3.984141546025052*^9}, {
