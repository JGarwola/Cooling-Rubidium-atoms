Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "PlotLiouvillianGap", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PlotLiouvillianGap", "[", 
    RowBox[{
    "ham_", ",", "dissipatorFunc_", ",", "params_", ",", "ranges_", ",", 
     RowBox[{"rules_", ":", 
      RowBox[{"{", "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "basis", ",", "liouvillianMatrix", ",", "applyL", ",", "matrixL", ",", 
       "evals", ",", "gapFunc", ",", "plotExpr"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "1.", " ", "Create", " ", "a", " ", "basis", " ", "of", " ", "3", "x3", 
       " ", "matrices", " ", "to", " ", "vectorize", " ", "the", " ", 
       "operator"}], "*)"}], 
     RowBox[{
      RowBox[{"basis", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"ReplacePart", "[", 
            RowBox[{
             RowBox[{"0", " ", "id"}], ",", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i", ",", "j"}], "}"}], "->", "1"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "3"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "2.", " ", "Define", " ", "the", " ", "action", " ", "of", " ", "the", 
        " ", "Liouvillian", " ", "on", " ", "a", " ", "matrix", " ", "rho"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"applyL", "[", "rho_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "I"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ham", ".", "rho"}], "-", 
           RowBox[{"rho", ".", "ham"}]}], ")"}]}], "+", 
        RowBox[{"dissipatorFunc", "[", "rho", "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "3.", " ", "Construct", " ", "the", " ", "9", "x9", " ", "Liouvillian",
         " ", "Matrix"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Each", " ", "column", " ", "is", " ", "the", " ", "vectorized", " ", 
        "result", " ", "of", " ", "L", " ", "acting", " ", "on", " ", "a", 
        " ", "basis", " ", "element"}], "*)"}], 
      RowBox[{"matrixL", "=", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"applyL", "[", "b", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"b", ",", "basis"}], "}"}]}], "]"}], "//", "Transpose"}]}],
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "4.", " ", "Define", " ", "the", " ", "Gap", " ", "Calculation"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "We", " ", "find", " ", "the", " ", "eigenvalue", " ", "with", " ", 
         "the", " ", "smallest", " ", "non"}], "-", 
        RowBox[{"zero", " ", "real", " ", "part"}]}], "*)"}], 
      RowBox[{
       RowBox[{"gapFunc", "[", 
        RowBox[{"p1_", ",", "p2_"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"numL", ",", "eigs", ",", "nonZeroEigs"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"numL", "=", 
           RowBox[{
            RowBox[{"matrixL", "/.", " ", 
             RowBox[{"Thread", "[", 
              RowBox[{"params", "->", 
               RowBox[{"{", 
                RowBox[{"p1", ",", "p2"}], "}"}]}], "]"}]}], "/.", " ", 
            "rules"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"eigs", "=", 
           RowBox[{"Eigenvalues", "[", "numL", "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Filter", " ", "out", " ", "the", " ", "zero", " ", "eigenvalue", 
            " ", 
            RowBox[{"(", 
             RowBox[{"steady", " ", "state"}], ")"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"nonZeroEigs", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"eigs", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", "#", "]"}], ">", 
               RowBox[{"10", "^", 
                RowBox[{"-", "10"}]}]}], "&"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "nonZeroEigs", "]"}], "==", "0"}], ",", 
            "0", ",", 
            RowBox[{"Min", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"Re", "[", "nonZeroEigs", "]"}], "]"}], "]"}]}], 
           "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"5.", " ", "Generate", " ", "Plot"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<--- Generating Liouvillian Gap Map ---\>\"", "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"ContourPlot", "[", 
       RowBox[{
        RowBox[{"gapFunc", "[", 
         RowBox[{
          RowBox[{"params", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"params", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"ranges", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"ranges", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
        RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
        RowBox[{"Contours", "->", "20"}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"params", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"params", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", "\"\<Liouvillian Spectral Gap\>\""}], ",", 
        RowBox[{"Exclusions", "->", "None"}]}], " ", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Ensures", " ", "we", " ", "see", " ", "where", " ", "it", " ", 
         "hits", " ", "zero"}], "*)"}], "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9841479862314196`*^9, 3.984147992954537*^9}, {
   3.9841480666578665`*^9, 3.984148085368653*^9}, 3.9841481275923834`*^9, {
   3.985430772953047*^9, 3.985430819656098*^9}, 3.9854308614118757`*^9},
