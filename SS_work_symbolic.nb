Cell[CellGroupData[{

Cell["Example 2: The Scovil-Schulz-DuBois (SSDB) Maser", "Section",
 CellChangeTimes->{{3.9835490128480916`*^9, 3.9835490233033466`*^9}, {
  3.983978446694163*^9, 
  3.9839784468017735`*^9}},ExpressionUUID->"4dc30afe-798c-4d3a-b1ee-\
201fbeb1e072"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"H", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"E1", "*", "id"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"E2", "-", "E1"}], ")"}], "*", 
        RowBox[{"gm", "[", "3", "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"E3", "-", "E1"}], ")"}], "*", 
        RowBox[{"gm", "[", "8", "]"}]}], "+", 
       RowBox[{"Omega", "*", 
        RowBox[{"(", 
         RowBox[{"gm", "[", "6", "]"}], ")"}]}]}], ")"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"E3", "->", "\[CapitalDelta]"}], ",", 
       RowBox[{"E2", "->", 
        RowBox[{"\[CapitalDelta]", "/", "2"}]}], ",", 
       RowBox[{"E1", "->", "0"}]}], "}"}]}]}], ";"}], " ", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"HotDown", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
  " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"HotUp", "=", 
    RowBox[{"ConjugateTranspose", "[", "HotDown", "]"}]}], ";"}], 
  "     "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ColdDown", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ColdUp", "=", 
    RowBox[{"ConjugateTranspose", "[", "ColdDown", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Dissipators", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"r", ",", 
      RowBox[{
       RowBox[{"\[Gamma]h", "*", 
        RowBox[{"LindbladDissipator", "[", 
         RowBox[{"HotDown", ",", "r"}], "]"}]}], "+", 
       RowBox[{"\[Gamma]h", "*", 
        RowBox[{"LindbladDissipator", "[", 
         RowBox[{"HotUp", ",", "r"}], "]"}]}], "+", 
       RowBox[{"\[Gamma]c", "*", 
        RowBox[{"LindbladDissipator", "[", 
         RowBox[{"ColdDown", ",", "r"}], "]"}]}], "+", 
       RowBox[{"\[Gamma]c", "*", 
        RowBox[{"LindbladDissipator", "[", 
         RowBox[{"ColdUp", ",", "r"}], "]"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoSS", "=", 
   RowBox[{"GetSteadyState", "[", 
    RowBox[{"H", ",", "Dissipators"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<--- Steady state ---\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"rhoSS", "//", "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{"AnalyzeGeometricHeat", "[", 
  RowBox[{"H", ",", "rhoSS", ",", "Dissipators", ",", 
   RowBox[{"{", 
    RowBox[{"\[CapitalDelta]", ",", "\[CapitalOmega]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[CapitalOmega]", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalDelta]", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Gamma]h", "->", "0.1"}], ",", 
     RowBox[{"\[Gamma]c", "->", "0.1"}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9835490292038307`*^9, 3.983549048734157*^9}, {
  3.9835496890867577`*^9, 3.9835496903668675`*^9}, {3.983979454380647*^9, 
