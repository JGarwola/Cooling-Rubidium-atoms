ba0ccb5e9e13"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"AnnihilationOp", "[", "n_", "]"}], ":=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"n", "-", "1"}], "]"}], "]"}], ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Pauli`\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Nmot", " ", "=", " ", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"AnnihilationOp", "[", "Nmot", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"adag", "=", 
   RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mF", " ", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"2", "0"},
      {"0", "1"}
     }], "\[NoBreak]", ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]up", "=", 
    FractionBox[
     RowBox[{
      RowBox[{"\[Sigma]", "[", "1", "]"}], "+", 
      RowBox[{"I", "*", 
       RowBox[{"\[Sigma]", "[", "2", "]"}]}]}], "2"]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Define", " ", "the", " ", "Hamiltonian"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Htot", "[", 
     RowBox[{"x0_", ",", "\[Omega]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[CapitalDelta]", "=", "1"}], ",", 
        RowBox[{"\[CapitalOmega]", "=", "1"}], ",", 
        RowBox[{"\[Mu]B", "=", "1"}], ",", 
        RowBox[{"dB", "=", "1"}], ",", 
        RowBox[{"m", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"xho", "=", " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"1", "/", "2"}], "m", "*", "\[Omega]"}]]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Eta]", "=", 
        FractionBox[
         RowBox[{"\[Mu]B", "*", "xho", "*", "dB"}], "2"]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Hmot", " ", "=", " ", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"\[Sigma]", "[", "0", "]"}], ",", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Omega]", "*", 
             RowBox[{"(", 
              RowBox[{"adag", ".", "a"}], ")"}]}], "-", 
            RowBox[{"\[Omega]", "*", 
             FractionBox["x0", "xho"], "*", 
             RowBox[{"(", 
              RowBox[{"adag", "+", "a"}], ")"}]}]}], ")"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Hspin", " ", "=", 
        RowBox[{"KroneckerProduct", "[", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[CapitalDelta]", "*", 
             RowBox[{"\[Sigma]", "[", "3", "]"}]}], "+", 
            RowBox[{"\[CapitalOmega]", "*", 
             RowBox[{"\[Sigma]", "[", "1", "]"}]}]}], ")"}], ",", 
          RowBox[{"IdentityMatrix", "[", "Nmot", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Hcoup", " ", "=", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"mF", ",", 
          RowBox[{"(", 
           RowBox[{"\[Eta]", "*", 
            RowBox[{"(", 
             RowBox[{"adag", "+", "a"}], ")"}]}], ")"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Hmot", "+", "Hspin", "+", "Hcoup"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Define", " ", "the", " ", "dissipator"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LOP", "[", "r_", "]"}], "[", "\[Gamma]up_", "]"}], ":=", 
   RowBox[{"LindbladDissipator", "[", 
    RowBox[{
     RowBox[{
      SqrtBox["\[Gamma]up"], "*", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"\[Sigma]up", ",", 
        RowBox[{"IdentityMatrix", "[", "Nmot", "]"}]}], "]"}]}], ",", "r"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LDP", "[", "r_", "]"}], "[", "\[Gamma]\[Phi]_", "]"}], ":=", 
   RowBox[{"LindbladDissipator", "[", 
    RowBox[{
     RowBox[{
      SqrtBox[
       RowBox[{"\[Gamma]\[Phi]", "/", "2"}]], "*", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"\[Sigma]", "[", "3", "]"}], ",", 
        RowBox[{"IdentityMatrix", "[", "Nmot", "]"}]}], "]"}]}], ",", "r"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LC", "[", "r_", "]"}], "[", 
    RowBox[{"\[CapitalGamma]m_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"LindbladDissipator", "[", 
    RowBox[{
     RowBox[{
      SqrtBox[
       RowBox[{"\[CapitalGamma]m", "*", 
        RowBox[{"(", 
         RowBox[{"n", "+", "1"}], ")"}]}]], "*", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"\[Sigma]", "[", "0", "]"}], ",", "a"}], "]"}]}], ",", "r"}], 
