Cell[CellGroupData[{

Cell["Heat curvature", "Subsection",
 CellChangeTimes->{
  3.98759482558755*^9, {3.987605594643674*^9, 3.9876055953975196`*^9}, 
   3.988116651514991*^9},ExpressionUUID->"f8fcc76e-8a77-4f26-838d-\
65c0c31ea8b4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "HeatCurvature", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"HeatCurvature", "[", 
    RowBox[{
    "hamFunc_", ",", "hTarget_", ",", "dissFunc_", ",", "params_", ",", 
     "ranges_", ",", "rules_", ",", 
     RowBox[{"points_", ":", "20"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "d", ",", "d2", ",", "basis", ",", "vec", ",", "unvec", ",", 
       "solveLResponse", ",", "getCurvaturePoint", ",", "p1Grid", ",", 
       "p2Grid", ",", "curvatureData"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Setup", " ", "Dimensions"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Htest", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"hamFunc", "@@", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ranges", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
               RowBox[{"ranges", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}]}], ")"}], "/.",
            " ", "rules"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"d", "=", 
          RowBox[{"Length", "[", "Htest", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"d2", "=", 
          RowBox[{"d", "^", "2"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"basis", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"ReplacePart", "[", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", 
               RowBox[{"{", 
                RowBox[{"d", ",", "d"}], "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i", ",", "j"}], "}"}], "->", "1"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "d"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "d"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vec", "[", "m_", "]"}], ":=", 
       RowBox[{"Flatten", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"unvec", "[", "v_", "]"}], ":=", 
       RowBox[{"Partition", "[", 
        RowBox[{"v", ",", "d"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"solveLResponse", "[", 
        RowBox[{"Lmat_", ",", "targetVec_"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"augMat", ",", "augRhs"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"augMat", "=", "Lmat"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"augMat", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "=", 
           RowBox[{"vec", "[", 
            RowBox[{"IdentityMatrix", "[", "d", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"augRhs", "=", "targetVec"}], ";", 
          RowBox[{
           RowBox[{"augRhs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "=", "0"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"LinearSolve", "[", 
           RowBox[{"augMat", ",", "augRhs"}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Point", "-", 
        RowBox[{"wise", " ", "Curvature", " ", "Kernel"}]}], "*)"}], 
      RowBox[{
       RowBox[{"getCurvaturePoint", "[", 
        RowBox[{"p1Val_", ",", "p2Val_"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pVals", "=", 
            RowBox[{"{", 
             RowBox[{"p1Val", ",", "p2Val"}], "}"}]}], ",", "Htot", ",", "Ht",
            ",", "Lmat", ",", "rhoVec", ",", "ns", ",", "step", ",", "drho", 
           ",", "dH"}], "}"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"step", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"p1Val", "*", 
              SuperscriptBox["10", 
               RowBox[{"-", "5"}]]}], ",", 
             RowBox[{"p2Val", "*", 
              SuperscriptBox["10", 
               RowBox[{"-", "5"}]]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"step", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#", "==", "0"}], ",", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "4"}]}], ",", 
                RowBox[{
                 RowBox[{"Abs", "[", "#", "]"}], "*", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", "4"}]}]}]}], "]"}], "&"}], ",", "pVals"}], 
            "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Steady", " ", "State", " ", "at", " ", "Center"}], "*)"}],
           "\[IndentingNewLine]", 
          RowBox[{"Htot", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"hamFunc", "@@", "pVals"}], ")"}], "/.", " ", 
            "rules"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Ht", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"hTarget", "@@", "pVals"}], ")"}], "/.", " ", 
            "rules"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Lmat", "=", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"vec", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "I"}], "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Htot", ".", "b"}], "-", 
                   RowBox[{"b", ".", "Htot"}]}], ")"}]}], "+", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"dissFunc", "[", "b", "]"}], "@@", "pVals"}], 
                 ")"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"b", ",", "basis"}], "}"}]}], "]"}], "//", 
            RowBox[{"Transpose", "/.", " ", "rules"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ns", "=", 
           RowBox[{"NullSpace", "[", "Lmat", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"rhoVec", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "ns", "]"}], "==", "0"}], ",", 
             RowBox[{
              RowBox[{"SingularValueDecomposition", "[", "Lmat", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "All", ",", 
                RowBox[{"-", "1"}]}], "]"}], "]"}], ",", 
             RowBox[{"ns", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"rhoVec", "=", 
           RowBox[{"rhoVec", "/", 
            RowBox[{"Tr", "[", 
             RowBox[{"unvec", "[", "rhoVec", "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Compute", " ", "Derivatives", " ", "of", " ", "H", " ", "and", 
            " ", "rho"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"drho", ",", "dH"}], "}"}], "=", 
           RowBox[{"Transpose", "@", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Module", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"pStep", "=", "pVals"}], ",", "Hstep", ",", 
                  "LmatStep", ",", "dLrho"}], "}"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"pStep", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "+=", 
                  RowBox[{"step", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"Hstep", "=", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"hamFunc", "@@", "pStep"}], ")"}], "/.", " ", 
                   "rules"}]}], ";", "\[IndentingNewLine]", 
                 RowBox[{"LmatStep", "=", 
                  RowBox[{
                   RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"vec", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "I"}], "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Hstep", ".", "b"}], "-", 
                    RowBox[{"b", ".", "Hstep"}]}], ")"}]}], "+", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"dissFunc", "[", "b", "]"}], "@@", "pStep"}], 
                    ")"}]}], "]"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{"b", ",", "basis"}], "}"}]}], "]"}], "//", 
                   RowBox[{"Transpose", "/.", " ", "rules"}]}]}], ";", 
                 "\[IndentingNewLine]", "\[IndentingNewLine]", 
                 RowBox[{"dLrho", "=", 
                  RowBox[{
                   RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"LmatStep", ".", "rhoVec"}], ")"}], "-", 
                    RowBox[{"(", 
                    RowBox[{"Lmat", ".", "rhoVec"}], ")"}]}], ")"}]}], "/", 
                   RowBox[{"step", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}]}], ";", 
                 "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"unvec", "[", 
                    RowBox[{"solveLResponse", "[", 
                    RowBox[{"Lmat", ",", "dLrho"}], "]"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"hamFunc", "@@", "pStep"}], "/.", " ", "rules"}], 
                    ")"}], "-", "Htot"}], ")"}], "/", 
                    RowBox[{"step", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}]}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "2"}], "}"}]}], "\[IndentingNewLine]", 
             "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Curvature", " ", 
            RowBox[{"Formula", ":", 
             RowBox[{
              RowBox[{"Tr", "[", 
               RowBox[{"dH_", "1", " ", "d_", "2", " ", "rho"}], "]"}], "-", 
              RowBox[{"Tr", "[", 
               RowBox[{"dH_", "2", " ", "d_", "1", " ", "rho"}], "]"}]}]}]}], 
           "*)"}], 
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"dH", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ".", 
              RowBox[{"drho", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "-", 
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"dH", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ".", 
              RowBox[{"drho", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}]}]}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Map", " ", "Generation"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"p1Grid", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"ranges", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"ranges", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "3"}], "]"}], "]"}], ",", "points"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"p2Grid", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"ranges", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"ranges", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "3"}], "]"}], "]"}], ",", "points"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Mapping Heat Curvature for \>\"", ",", "params", ",", 
        "\"\<...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"curvatureData", "=", 
       RowBox[{"Monitor", "[", 
        RowBox[{
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"p2", ",", "p1", ",", 
             RowBox[{"getCurvaturePoint", "[", 
              RowBox[{"p1", ",", "p2"}], "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"p1", ",", "p1Grid"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"p2", ",", "p2Grid"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"ProgressIndicator", "[", 
          RowBox[{"p1", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ranges", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"ranges", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "3"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"flatData", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"curvatureData", ",", "1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"maxVal", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"flatData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"flatData", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", "maxVal", "]"}], ">", "0"}], ",", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "/", "maxVal"}]}], "}"}], 
            "&"}], ",", "flatData"}], "]"}], ",", "flatData"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"flatData", ",", "maxVal"}], "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9875968674149475`*^9, 3.9875970306179805`*^9}, {
