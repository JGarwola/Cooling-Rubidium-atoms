Cell[TextData[{
 "Compare reversible and dissipative heat ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["Q", "diss"], "=", 
    RowBox[{"-", 
     RowBox[{"\[Integral]", 
      RowBox[{"dt", " ", 
       SubscriptBox["g", "ij"], 
