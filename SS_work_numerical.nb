Cell[CellGroupData[{

Cell["Example: Motion-TLS coupled system", "Section",
 CellChangeTimes->{{3.9875910189717646`*^9, 3.9875910256393547`*^9}, {
   3.987594843782449*^9, 3.9875948458865323`*^9}, 
   3.9876069577333565`*^9},ExpressionUUID->"27657fe3-0588-4bee-ac2d-\
7ab7cdedcb9e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "operators"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Nmot", "=", "3"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"idM", "=", 
     RowBox[{"IdentityMatrix", "[", "Nmot", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"idS", "=", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"Range", "[", 
         RowBox[{"Nmot", "-", "1"}], "]"}], "]"}], ",", "1"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"adag", "=", 
     RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[HBar]", "=", 
     RowBox[{"1.05", "*", 
      SuperscriptBox["10", 
       RowBox[{"-", "34"}]]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x0", " ", "\[Element]", " ", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{"0", ",", "10"}], "]"}], "\[Mu]m"}]}], ",", " ", 
     RowBox[{"\[Omega]", " ", "\[Element]", " ", 
      RowBox[{"2", 
       RowBox[{"\[Pi]", " ", "[", 
        RowBox[{"50", ",", "500"}], "]"}], " ", "Hz"}]}], ",", " ", 
     RowBox[{"\[Omega]RF", " ", "\[Element]", " ", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{"1", ",", "10"}], "]"}], " ", "MHz"}]}], ",", " ", 
     RowBox[{"\[CapitalOmega]", " ", "\[Element]", " ", 
      RowBox[{"2", 
       RowBox[{"\[Pi]", "[", 
        RowBox[{"10", ",", 
         SuperscriptBox["10", "4"]}], "]"}], "Hz"}]}]}], 
    "\[IndentingNewLine]", " ", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Htot", " ", "Wrapper"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Htot", "[", 
      RowBox[{
      "x0_", ",", "\[Omega]_", ",", "\[Omega]RF_", ",", "\[CapitalOmega]_"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Mu]B", "=", 
          RowBox[{"9.27", "*", 
           SuperscriptBox["10", 
            RowBox[{"-", "24"}]]}]}], ",", 
         RowBox[{"B0", "=", 
          SuperscriptBox["10", 
           RowBox[{"-", "3"}]]}], ",", 
         RowBox[{"dB", "=", "1.0"}], ",", 
         RowBox[{"m", "=", 
          RowBox[{"1.44", "*", 
           SuperscriptBox["10", 
            RowBox[{"-", "25"}]]}]}], ",", 
         RowBox[{"gF", "=", 
          FractionBox["1", "2"]}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"xho", "=", " ", 
         SqrtBox[
          RowBox[{"\[HBar]", "/", 
           RowBox[{"(", 
            RowBox[{"2", "m", "*", "\[Omega]"}], ")"}]}]]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Eta]", "=", 
         RowBox[{"gF", "*", "\[Mu]B", "*", "xho", "*", 
          RowBox[{"dB", "/", "\[HBar]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[CapitalDelta]", "=", 
         RowBox[{"\[Omega]RF", "-", 
          FractionBox[
           RowBox[{"\[Mu]B", " ", "*", "gF", "*", " ", "B0"}], "\[HBar]"]}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"Hmot", " ", "=", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"\[Sigma]0", ",", 
           RowBox[{"\[Omega]", "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"adag", ".", "a"}], "-", 
              RowBox[{
               FractionBox["x0", "xho"], "*", 
               RowBox[{"(", 
                RowBox[{"adag", "+", "a"}], ")"}]}]}], ")"}]}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Hspin", " ", "=", 
         RowBox[{"KroneckerProduct", "[", " ", 
          RowBox[{
           RowBox[{
            FractionBox["1", "2"], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[CapitalDelta]", "*", "\[Sigma]3"}], "+", 
              RowBox[{"\[CapitalOmega]", "*", "\[Sigma]1"}]}], ")"}]}], ",", 
           RowBox[{"IdentityMatrix", "[", "Nmot", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Hcoup", " ", "=", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"\[Sigma]3", ",", 
           RowBox[{
            RowBox[{"-", "\[Eta]"}], "*", 
            RowBox[{"(", 
             RowBox[{"adag", "+", "a"}], ")"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Hmot", "+", "Hspin", "+", "Hcoup"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"HtotFunc", " ", "=", " ", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Omega]RF", ",", "\[CapitalOmega]"}], "}"}], ",", 
       RowBox[{"Htot", "[", 
        RowBox[{
         SuperscriptBox["10", 
          RowBox[{"-", "5"}]], ",", 
         RowBox[{"2", "\[Pi]", " ", "500"}], ",", "\[Omega]RF", ",", 
         "\[CapitalOmega]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HRefFunc", "[", 
      RowBox[{"\[Omega]RF_", ",", "\[CapitalOmega]_"}], "]"}], ":=", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"idS", ",", 
       RowBox[{"1.0", "*", 
        RowBox[{"(", 
         RowBox[{"adag", ".", "a"}], ")"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Define", " ", "the", " ", "dissipator"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"LOP", "[", "r_", "]"}], "[", "\[Gamma]up_", "]"}], ":=", 
     RowBox[{"LindbladDissipator", "[", 
      RowBox[{
       RowBox[{
        SqrtBox["\[Gamma]up"], "*", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"\[Sigma]up", ",", 
          RowBox[{"IdentityMatrix", "[", "Nmot", "]"}]}], "]"}]}], ",", "r"}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"LDP", "[", "r_", "]"}], "[", "\[Gamma]\[Phi]_", "]"}], ":=", 
     RowBox[{"LindbladDissipator", "[", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"\[Gamma]\[Phi]", "/", "2"}]], "*", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"\[Sigma]3", ",", 
          RowBox[{"IdentityMatrix", "[", "Nmot", "]"}]}], "]"}]}], ",", "r"}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"LC", "[", "r_", "]"}], "[", 
      RowBox[{"\[CapitalGamma]m_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"LindbladDissipator", "[", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"\[CapitalGamma]m", "*", 
          RowBox[{"(", 
           RowBox[{"n", "+", "1"}], ")"}]}]], "*", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"\[Sigma]0", ",", "a"}], "]"}]}], ",", "r"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"LH", "[", "r_", "]"}], "[", 
      RowBox[{"\[CapitalGamma]m_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"LindbladDissipator", "[", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"\[CapitalGamma]m", "*", "n"}]], "*", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"\[Sigma]0", ",", "adag"}], "]"}]}], ",", "r"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"diss", "[", "r_", "]"}], "[", 
      RowBox[{"\[Omega]RF_", ",", "\[CapitalOmega]_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Gamma]up", "=", 
          SuperscriptBox["10", "3"]}], ",", 
         RowBox[{"\[Gamma]\[Phi]", "=", "1.0"}], ",", 
         RowBox[{"\[CapitalGamma]m", "=", "1.0"}], ",", 
         RowBox[{"n", "=", "100"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"LOP", "[", "r", "]"}], "[", "\[Gamma]up", "]"}], "+", 
         RowBox[{
          RowBox[{"LDP", "[", "r", "]"}], "[", "\[Gamma]\[Phi]", "]"}], "+", 
         RowBox[{
          RowBox[{"LC", "[", "r", "]"}], "[", 
          RowBox[{"\[CapitalGamma]m", ",", "n"}], "]"}], "+", 
         RowBox[{
          RowBox[{"LH", "[", "r", "]"}], "[", 
          RowBox[{"\[CapitalGamma]m", ",", "n"}], "]"}]}], ")"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "the", " ", "Heat", " ", "Curvature", " ", "Map"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", "maxVal"}], "}"}], " ", "=", 
     RowBox[{"HeatCurvature", "[", 
      RowBox[{"HtotFunc", ",", "HRefFunc", ",", "diss", ",", 
       RowBox[{"{", 
        RowBox[{"\[Omega]RF", ",", "\[CapitalOmega]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Omega]RF", ",", 
           SuperscriptBox["10", "6"], ",", 
           SuperscriptBox["10", "7"]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[CapitalOmega]", ",", 
           RowBox[{"2", "\[Pi]", " ", "10"}], ",", 
           RowBox[{"2", "\[Pi]", " ", 
            SuperscriptBox["10", "4"]}]}], "}"}]}], "}"}], ",", 
       RowBox[{"{", "}"}], ",", "20"}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"plot", "=", 
    RowBox[{"ListContourPlot", "[", "\[IndentingNewLine]", 
     RowBox[{"data", ",", "\[IndentingNewLine]", 
      RowBox[{"ColorFunction", "->", 
       RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotLegends", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
        "\"\<\!\(\*SubscriptBox[\(\[Omega]\), \(RF\)]\) [Hz]\>\"", ",", 
         "\"\<\[CapitalOmega] [Hz]\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Heat Curvature times \>\"", ",", 
          RowBox[{"ScientificForm", "[", "maxVal", "]"}], ",", 
          "\"\<[J/\!\(\*SuperscriptBox[\(Hz\), \(2\)]\)]\>\""}], "}"}], 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", 
        "\"\<motion_TLS.pdf\>\""}], "}"}], "]"}], ",", "plot"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9875943778860826`*^9, 3.987594391925696*^9}, {
