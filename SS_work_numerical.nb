Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "a", " ", "helper", " ", "function", " ", "for", " ", "the",
     " ", "Lindblad", " ", "Dissipator"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"LindbladDissipator", "[", 
     RowBox[{"L_", ",", "p_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"L", ".", "p", ".", 
      RowBox[{"ConjugateTranspose", "[", "L", "]"}]}], "-", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", "L", "]"}], ".", "L", ".", "p"}], 
        "+", 
        RowBox[{"p", ".", 
         RowBox[{"ConjugateTranspose", "[", "L", "]"}], ".", "L"}]}], 
       ")"}]}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Pauli", " ", "Matrices"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Sigma]0", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Sigma]1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Sigma]2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "I"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"I", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Sigma]3", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Sigma]up", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Sigma]1", "+", 
        RowBox[{"I", "*", "\[Sigma]2"}]}], ")"}], "/", "2"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9876070624985876`*^9, 3.987607062877234*^9}, {
