Cell[CellGroupData[{

Cell["Example: Motional Hamiltonian", "Section",
 CellChangeTimes->{{3.987610082574574*^9, 3.9876100919580765`*^9}, 
   3.987610277179407*^9},ExpressionUUID->"3c208639-1670-4640-88fe-\
853c1c2448e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "operators"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Nmot", "=", "2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"idM", "=", 
     RowBox[{"IdentityMatrix", "[", "Nmot", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"idS", "=", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"Range", "[", 
         RowBox[{"Nmot", "-", "1"}], "]"}], "]"}], ",", "1"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"adag", "=", 
     RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Htot", " ", "Wrapper"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Htot", "[", 
      RowBox[{"\[CapitalOmega]_", ",", "U_", ",", "F_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"\[CapitalOmega]", "*", 
       RowBox[{"(", 
        RowBox[{"adag", ".", "a"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"U", "/", "2"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"adag", ".", "adag", ".", "a", ".", "a"}], ")"}]}], "+", 
      RowBox[{"F", "*", 
       RowBox[{"(", 
        RowBox[{"adag", "+", "a"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"HtotFunc", " ", "=", " ", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[CapitalOmega]", ",", "F"}], "}"}], ",", 
       RowBox[{"Htot", "[", 
        RowBox[{"\[CapitalOmega]", ",", "1.0", ",", "F"}], "]"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"LCool", "[", "r_", "]"}], "[", 
      RowBox[{"\[Gamma]c_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"\[Gamma]c", "*", 
      RowBox[{"(", 
       RowBox[{"n", "+", "1"}], ")"}], "*", 
      RowBox[{"LindbladDissipator", "[", 
       RowBox[{"a", ",", "r"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"LHeat", "[", "r_", "]"}], "[", 
      RowBox[{"\[Gamma]h_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"\[Gamma]h", "*", "n", "*", 
      RowBox[{"LindbladDissipator", "[", 
       RowBox[{"adag", ",", "r"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"L3Body", "[", "r_", "]"}], "[", "\[Gamma]3_", "]"}], ":=", 
     RowBox[{"\[Gamma]3", "*", 
      RowBox[{"LindbladDissipator", "[", 
       RowBox[{
        RowBox[{"a", ".", "a", ".", "a"}], ",", "r"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"diss", "[", "r_", "]"}], "[", 
      RowBox[{"\[CapitalOmega]_", ",", "F_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Gamma]c", "=", "1.0"}], ",", 
         RowBox[{"\[Gamma]h", "=", "1.0"}], ",", 
         RowBox[{"\[Gamma]3", "=", "1.0"}], ",", 
         RowBox[{"n", "=", "100"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"LCool", "[", "r", "]"}], "[", 
         RowBox[{"\[Gamma]c", ",", "n"}], "]"}], "+", 
        RowBox[{
         RowBox[{"LHeat", "[", "r", "]"}], "[", 
         RowBox[{"\[Gamma]h", ",", "n"}], "]"}], "+", 
        RowBox[{
         RowBox[{"L3Body", "[", "r", "]"}], "[", "\[Gamma]3", "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", "maxVal"}], "}"}], " ", "=", 
     RowBox[{"HeatCurvature", "[", 
      RowBox[{"HtotFunc", ",", "HtotFunc", ",", "diss", ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalOmega]", ",", "F"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[CapitalOmega]", ",", "0", ",", "10"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"F", ",", "0", ",", "10"}], "}"}]}], "}"}], ",", 
       RowBox[{"{", "}"}], ",", "10"}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"plot", "=", 
    RowBox[{"ListContourPlot", "[", "\[IndentingNewLine]", 
     RowBox[{"data", ",", "\[IndentingNewLine]", 
      RowBox[{"ColorFunction", "->", 
       RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotLegends", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<\[CapitalOmega] [?]\>\"", ",", "\"\<F [?]\>\""}], 
        "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Heat Curvature times \>\"", ",", 
          RowBox[{"ScientificForm", "[", "maxVal", "]"}], ",", 
          "\"\<[?]\>\""}], "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", 
        "\"\<motional.pdf\>\""}], "}"}], "]"}], ",", "plot"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9876102894981356`*^9, 3.987610635625822*^9}, {
  3.9876106696572742`*^9, 3.9876106802050123`*^9}, {3.987611024760532*^9, 
