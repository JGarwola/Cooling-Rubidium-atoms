Cell[CellGroupData[{

Cell["Example: 3-level Rubidium atom", "Section",
 CellChangeTimes->{{3.98708553150202*^9, 3.987085538045203*^9}, {
  3.988109635589966*^9, 
  3.9881096387451763`*^9}},ExpressionUUID->"679f7353-d337-43c6-a768-\
c601bbe49083"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{"\[CapitalDelta]", "=", 
    RowBox[{"2", 
     RowBox[{"\[Pi]", " ", "[", 
      RowBox[{
       RowBox[{"-", "100"}], ",", "100"}], "]"}], " ", "MHz"}]}], ",", " ", 
   RowBox[{"\[CapitalOmega]", "=", 
    RowBox[{"2", 
     RowBox[{"\[Pi]", " ", "[", 
      RowBox[{"0", ",", "10"}], "]"}], " ", "MHz"}]}], ",", " ", 
   RowBox[{
    SubscriptBox["\[Gamma]", "d"], "=", 
    RowBox[{"2", "\[Pi]", " ", "6.1", " ", "MHz"}]}], ",", " ", 
   RowBox[{
    SubscriptBox["\[Gamma]", "\[Phi]"], "=", 
    RowBox[{"1", " ", "MHz"}]}]}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.987087930290203*^9, 3.9870879342334576`*^9}, {
  3.9881095087569*^9, 
  3.9881095090658836`*^9}},ExpressionUUID->"c18cf78e-b5aa-486c-a528-\
016161b397b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Define", " ", "the", " ", "Hamiltonian"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"HR", "[", 
      RowBox[{"\[CapitalDelta]_", ",", "\[CapitalOmega]_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[CapitalOmega]1", ",", "\[CapitalOmega]2", ",", "\[CapitalDelta]1", 
         ",", "\[CapitalDelta]2"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[CapitalDelta]1", "=", 
         RowBox[{"\[CapitalDelta]", "/", "10"}]}], ";", " ", 
        RowBox[{"\[CapitalDelta]2", "=", "\[CapitalDelta]"}], ";", 
        RowBox[{"\[CapitalOmega]1", "=", "\[CapitalOmega]"}], ";", 
        RowBox[{"\[CapitalOmega]2", "=", "\[CapitalOmega]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"H", "=", 
         RowBox[{"(", "\[NoBreak]", GridBox[{
            {"0", "0", 
             RowBox[{"\[CapitalOmega]1", "/", "2"}]},
            {"0", "\[CapitalDelta]1", 
             RowBox[{"\[CapitalOmega]2", "/", "2"}]},
            {
             RowBox[{"\[CapitalOmega]1", "/", "2"}], 
             RowBox[{"\[CapitalOmega]2", "/", "2"}], "\[CapitalDelta]2"}
           }], "\[NoBreak]", ")"}]}], ";", "H"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Define", " ", "the", " ", "dissipator"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"LDiss1", "[", "r_", "]"}], "[", "\[Gamma]d_", "]"}], ":=", 
     RowBox[{"LindbladDissipator", "[", 
      RowBox[{
       RowBox[{"\[Gamma]d", "*", 
        RowBox[{"(", "\[NoBreak]", GridBox[{
           {"0", "1", "0"},
           {"0", "0", "0"},
           {"0", "0", "0"}
          }], "\[NoBreak]", ")"}]}], ",", "r"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"LDiss2", "[", "r_", "]"}], "[", "\[Gamma]d_", "]"}], ":=", 
     RowBox[{"LindbladDissipator", "[", 
      RowBox[{
       RowBox[{"\[Gamma]d", "*", 
        RowBox[{"(", "\[NoBreak]", GridBox[{
           {"0", "0", "1"},
           {"0", "0", "0"},
           {"0", "0", "0"}
          }], "\[NoBreak]", ")"}]}], ",", "r"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"LD1", "[", "r_", "]"}], "[", "\[Gamma]\[Phi]_", "]"}], ":=", 
     RowBox[{"LindbladDissipator", "[", 
      RowBox[{
       RowBox[{"\[Gamma]\[Phi]", "*", 
        RowBox[{"(", "\[NoBreak]", GridBox[{
           {"0", "0", "0"},
           {"0", "1", "0"},
           {"0", "0", 
            RowBox[{"-", "1"}]}
          }], "\[NoBreak]", ")"}]}], ",", "r"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"LD2", "[", "r_", "]"}], "[", "\[Gamma]\[Phi]_", "]"}], ":=", 
     RowBox[{"LindbladDissipator", "[", 
      RowBox[{
       RowBox[{"\[Gamma]\[Phi]", "*", 
        RowBox[{"(", "\[NoBreak]", GridBox[{
           {"1", "0", "0"},
           {"0", "0", "0"},
           {"0", "0", 
            RowBox[{"-", "1"}]}
          }], "\[NoBreak]", ")"}]}], ",", "r"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"diss", "[", "r_", "]"}], "[", 
      RowBox[{"\[CapitalDelta]_", ",", "\[CapitalOmega]_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Gamma]d", "=", 
          RowBox[{"2", " ", "*", "\[Pi]", "*", " ", "6.1"}]}], ",", 
         RowBox[{"\[Gamma]\[Phi]", "=", "0.0"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"LDiss1", "[", "r", "]"}], "[", "\[Gamma]d", "]"}], "+", 
        RowBox[{
         RowBox[{"LDiss2", "[", "r", "]"}], "[", "\[Gamma]d", "]"}], "+", 
        RowBox[{
         RowBox[{"LD1", "[", "r", "]"}], "[", "\[Gamma]\[Phi]", "]"}], "+", 
        RowBox[{
         RowBox[{"LD2", "[", "r", "]"}], "[", "\[Gamma]\[Phi]", "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"H1", "=", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", "\[CapitalOmega]"}], "}"}], ",", 
       RowBox[{"HR", "[", 
        RowBox[{"\[CapitalDelta]", ",", "\[CapitalOmega]"}], "]"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", "maxVal"}], "}"}], " ", "=", 
     RowBox[{"HeatCurvature", "[", 
      RowBox[{"H1", ",", "H1", ",", "diss", ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", "\[CapitalOmega]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[CapitalDelta]", ",", 
           RowBox[{
            RowBox[{"-", "2"}], "\[Pi]", " ", "100"}], ",", 
           RowBox[{"2", "\[Pi]", " ", "100"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[CapitalOmega]", ",", 
           RowBox[{"2", "\[Pi]"}], ",", 
           RowBox[{"2", "\[Pi]", " ", "10"}]}], "}"}]}], "}"}], ",", 
       RowBox[{"{", "}"}], ",", "20"}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"plot", "=", 
    RowBox[{"ListContourPlot", "[", "\[IndentingNewLine]", 
     RowBox[{"data", ",", "\[IndentingNewLine]", 
      RowBox[{"ColorFunction", "->", 
       RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotLegends", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
        "\"\<\[CapitalOmega] [MHz]\>\"", ",", 
         "\"\<\[CapitalDelta] [MHz]\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Heat Curvature times \>\"", ",", 
          RowBox[{"ScientificForm", "[", "maxVal", "]"}], ",", 
          "\"\<\[HBar] [J/\!\(\*SuperscriptBox[\(MHz\), \(2\)]\)]\>\""}], 
         "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<3lvl_Rb.pdf\>\""}],
        "}"}], "]"}], ",", "plot"}], "]"}]}]}]], "Input",
