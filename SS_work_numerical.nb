Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "ComputeCycleHeats", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ComputeCycleHeats", "[", 
    RowBox[{
    "hamFunc_", ",", "hamRef_", ",", "dissFunc_", ",", "params_", ",", 
     "rules_", ",", "pMin_", ",", "pMax_", ",", 
     RowBox[{"tau_", ":", 
      RowBox[{"2", " ", "Pi"}]}], ",", 
     RowBox[{"points_", ":", "50"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "d", ",", "d2", ",", "basis", ",", "vec", ",", "unvec", ",", 
       "solveLResponse", ",", "getNumericalData", ",", "tStep", ",", 
       "gridData", ",", "qGeo", ",", "qDiss"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Setup", " ", "Dimensions", " ", "and", " ", "Vectorization"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Htest", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"hamFunc", "@@", "pMin"}], ")"}], "/.", " ", "rules"}]}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"d", "=", 
          RowBox[{"Length", "[", "Htest", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"d2", "=", 
          RowBox[{"d", "^", "2"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"basis", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"ReplacePart", "[", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", 
               RowBox[{"{", 
                RowBox[{"d", ",", "d"}], "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i", ",", "j"}], "}"}], "->", "1"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "d"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "d"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vec", "[", "m_", "]"}], ":=", 
       RowBox[{"Flatten", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"unvec", "[", "v_", "]"}], ":=", 
       RowBox[{"Partition", "[", 
        RowBox[{"v", ",", "d"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Robust", " ", "Linear", " ", "Response", " ", "Solver"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"solveLResponse", "[", 
        RowBox[{"Lmat_", ",", "targetVec_"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"augMat", ",", "augRhs"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"augMat", "=", "Lmat"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"augMat", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "=", 
           RowBox[{"vec", "[", 
            RowBox[{"IdentityMatrix", "[", "d", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"augRhs", "=", "targetVec"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"augRhs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "=", "0"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"LinearSolve", "[", 
           RowBox[{"augMat", ",", "augRhs"}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Numerical", " ", "Kernel", " ", "with", " ", "Rectangular", " ", 
        "Parameterization"}], "*)"}], 
      RowBox[{
       RowBox[{"getNumericalData", "[", "tVal_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "pVals", ",", "H", ",", "Href", ",", "Lmat", ",", "rhoVec", ",", 
           "rho", ",", "dLrhoVec", ",", "drho", ",", "Ai", ",", "gMetric", 
           ",", "vel", ",", 
           RowBox[{"step", "=", 
            RowBox[{"10", "^", 
             RowBox[{"-", "6"}]}]}], ",", "ns", ",", "segment", ",", 
           "localT"}], "}"}], ",", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"segment", "=", 
           RowBox[{"Floor", "[", "tVal", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"localT", "=", 
           RowBox[{"Mod", "[", 
            RowBox[{"tVal", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"tVal", "==", "4.0"}], ",", 
            RowBox[{
             RowBox[{"segment", "=", "3"}], ";", 
             RowBox[{"localT", "=", "1.0"}], ";"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Handle", " ", "boundary"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Segment", " ", "0"}], ":", 
             RowBox[{"(", 
              RowBox[{"xMin", ",", "yMin"}], ")"}]}], "->", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"xMax", ",", "yMin"}], ")"}], "\[IndentingNewLine]", 
               " ", "Segment", " ", "1"}], ":", 
              RowBox[{"(", 
               RowBox[{"xMax", ",", "yMin"}], ")"}]}], "->", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"xMax", ",", "yMax"}], ")"}], " ", 
                "\[IndentingNewLine]", "Segment", " ", "2"}], ":", 
               RowBox[{"(", 
                RowBox[{"xMax", ",", "yMax"}], ")"}]}], "->", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"xMin", ",", "yMax"}], ")"}], " ", 
                 "\[IndentingNewLine]", "Segment", " ", "3"}], ":", 
                RowBox[{"(", 
                 RowBox[{"xMin", ",", "yMax"}], ")"}]}], "->", 
               RowBox[{"(", 
                RowBox[{"xMin", ",", "yMin"}], ")"}]}]}]}]}], 
           "\[IndentingNewLine]", "\[IndentingNewLine]", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"Switch", "[", 
           RowBox[{
           "segment", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", "0", 
            ",", 
            RowBox[{
             RowBox[{"pVals", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"pMin", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "+", 
                 RowBox[{"localT", "*", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"pMax", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", 
                    RowBox[{"pMin", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}], ",", 
                RowBox[{"pMin", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], ";", 
             RowBox[{"vel", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"pMax", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", 
                 RowBox[{"pMin", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", "0.0"}], "}"}]}]}], 
            ",", "\[IndentingNewLine]", "\[IndentingNewLine]", "1", ",", 
            RowBox[{
             RowBox[{"pVals", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"pMax", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"pMin", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "+", 
                 RowBox[{"localT", "*", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"pMax", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                    RowBox[{"pMin", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}]}]}], "}"}]}], 
             ";", 
             RowBox[{"vel", "=", 
              RowBox[{"{", 
               RowBox[{"0.0", ",", 
                RowBox[{
                 RowBox[{"pMax", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", 
                 RowBox[{"pMin", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}]}], ",", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", "2", ",", 
            RowBox[{
             RowBox[{"pVals", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"pMax", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", 
                 RowBox[{"localT", "*", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"pMax", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", 
                    RowBox[{"pMin", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}], ",", 
                RowBox[{"pMax", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], ";", 
             RowBox[{"vel", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"pMax", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", 
                   RowBox[{"pMin", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], ",", "0.0"}], 
               "}"}]}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "3", ",", 
            RowBox[{
             RowBox[{"pVals", "=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"pMin", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"pMax", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", 
                 RowBox[{"localT", "*", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"pMax", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                    RowBox[{"pMin", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}]}]}], "}"}]}], 
             ";", 
             RowBox[{"vel", "=", 
              RowBox[{"{", 
               RowBox[{"0.0", ",", 
                RowBox[{"-", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"pMax", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", 
                   RowBox[{"pMin", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}]}], "}"}]}]}]}], 
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Local", " ", "Matrices"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"H", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"hamFunc", "@@", "pVals"}], ")"}], "/.", " ", 
            "rules"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Href", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"hamRef", "@@", "pVals"}], ")"}], "/.", " ", "rules"}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"Lmat", "=", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"vec", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "I"}], "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"H", ".", "b"}], "-", 
                   RowBox[{"b", ".", "H"}]}], ")"}]}], "+", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"dissFunc", "[", "b", "]"}], "@@", "pVals"}], 
                 ")"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"b", ",", "basis"}], "}"}]}], "]"}], "//", 
            RowBox[{"Transpose", "/.", " ", "rules"}]}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Robust", " ", "Steady", " ", "State", " ", "extraction"}],
            "*)"}], "\[IndentingNewLine]", 
          RowBox[{"ns", "=", 
           RowBox[{"NullSpace", "[", "Lmat", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "ns", "]"}], "==", "0"}], ",", 
            RowBox[{"rhoVec", "=", 
             RowBox[{
              RowBox[{"SingularValueDecomposition", "[", "Lmat", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "All", ",", 
                RowBox[{"-", "1"}]}], "]"}], "]"}]}], ",", 
            RowBox[{"rhoVec", "=", 
             RowBox[{"ns", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"rho", "=", 
           RowBox[{"unvec", "[", 
            RowBox[{"rhoVec", "/", 
             RowBox[{"Tr", "[", 
              RowBox[{"unvec", "[", "rhoVec", "]"}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Finite", " ", "Difference", " ", "for", " ", "d_i", 
            RowBox[{"(", "rho", ")"}]}], "*)"}], 
          RowBox[{"drho", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "pStep", ",", "Hstep", ",", "LmatStep", ",", "dLvec"}], "}"}],
                ",", 
               RowBox[{
                RowBox[{"pStep", "=", "pVals"}], ";", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"pStep", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "+=", "step"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Hstep", "=", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"hamFunc", "@@", "pStep"}], ")"}], "/.", " ", 
                  "rules"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"LmatStep", "=", 
                 RowBox[{
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"vec", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "I"}], "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Hstep", ".", "b"}], "-", 
                    RowBox[{"b", ".", "Hstep"}]}], ")"}]}], "+", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"dissFunc", "[", "b", "]"}], "@@", "pStep"}], 
                    ")"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"b", ",", "basis"}], "}"}]}], "]"}], "//", 
                  RowBox[{"Transpose", "/.", " ", "rules"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"dLvec", "=", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"LmatStep", ".", "rhoVec"}], ")"}], "-", 
                    RowBox[{"(", 
                    RowBox[{"Lmat", ".", "rhoVec"}], ")"}]}], ")"}]}], "/", 
                  "step"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"unvec", "[", 
                 RowBox[{"solveLResponse", "[", 
                  RowBox[{"Lmat", ",", "dLvec"}], "]"}], "]"}]}]}], "]"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "2"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Compute", " ", "Metrics"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Ai", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Re", "@", 
              RowBox[{"Tr", "[", 
               RowBox[{"Href", ".", 
                RowBox[{"drho", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "2"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"gMetric", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Re", "@", 
              RowBox[{"Tr", "[", 
               RowBox[{
                RowBox[{"drho", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ".", 
                RowBox[{"unvec", "[", 
                 RowBox[{"solveLResponse", "[", 
                  RowBox[{"Lmat", ",", 
                   RowBox[{"vec", "[", 
                    RowBox[{"drho", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "]"}], "]"}]}], 
               "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Ai", ".", "vel"}], ",", 
            RowBox[{"vel", ".", "gMetric", ".", "vel"}]}], "}"}]}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Execution", " ", "and", " ", "Integration"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Starting rectangular cycle integration for d=\>\"", ",", "d", 
        ",", "\"\< system...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"gridData", "=", 
       RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"getNumericalData", "[", "t", "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"t", ",", 
             RowBox[{"Subdivide", "[", 
              RowBox[{"0.0", ",", "4.0", ",", "points"}], "]"}]}], "}"}]}], 
          "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"ProgressIndicator", "[", 
          RowBox[{"t", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "4.0"}], "}"}]}], "]"}]}], 
        "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"tStep", "=", 
       RowBox[{"4.0", "/", "points"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"qGeo", "=", 
       RowBox[{"tStep", "*", 
        RowBox[{"Total", "[", 
         RowBox[{"gridData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qDiss", "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1.0", "/", "tau"}], ")"}]}], "*", "tStep", "*", 
        RowBox[{"Total", "[", 
         RowBox[{"gridData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<--- Results ---\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Geometric Heat: \>\"", ",", "qGeo"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Dissipated Heat: \>\"", ",", "qDiss"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Net: \>\"", ",", 
        RowBox[{"qGeo", "+", "qDiss"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"qGeo", ",", "qDiss"}], "}"}]}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.984148779806883*^9, 3.9841487959604826`*^9}, 
