Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "ComputeCycleHeats", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ComputeCycleHeats", "[", 
    RowBox[{
    "hamFunc_", ",", "dissFunc_", ",", "params_", ",", "rules_", ",", "R_", 
     ",", "offset_", ",", 
     RowBox[{"tau_", ":", 
      RowBox[{"2", " ", "Pi"}]}], ",", 
     RowBox[{"points_", ":", "50"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "d", ",", "d2", ",", "basis", ",", "vec", ",", "unvec", ",", 
       "solveLResponse", ",", "getNumericalData", ",", "path", ",", "dPath", 
       ",", "tStep", ",", "stepSize", ",", "gridData", ",", "qGeo", ",", 
       "qDiss"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"1.", " ", "Dimension", " ", "Detection"}], "&"}], " ", 
       "Vectorization", " ", "Setup"}], "*)"}], 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Htest", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"hamFunc", "@@", "offset"}], ")"}], "/.", " ", 
           "rules"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"d", "=", 
          RowBox[{"Length", "[", "Htest", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"d2", "=", 
          RowBox[{"d", "^", "2"}]}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"basis", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"ReplacePart", "[", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", 
               RowBox[{"{", 
                RowBox[{"d", ",", "d"}], "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i", ",", "j"}], "}"}], "->", "1"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "d"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "d"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vec", "[", "m_", "]"}], ":=", 
       RowBox[{"Flatten", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"unvec", "[", "v_", "]"}], ":=", 
       RowBox[{"Partition", "[", 
        RowBox[{"v", ",", "d"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"2.", " ", "Linear", " ", "Response", " ", 
         RowBox[{"Solver", ":", 
          RowBox[{"Solves", " ", "L", 
           RowBox[{"(", "X", ")"}]}]}]}], "=", 
        RowBox[{"target", " ", "for", " ", "X"}]}], "*)"}], 
      RowBox[{
       RowBox[{"solveLResponse", "[", 
        RowBox[{"Lmat_", ",", "targetVec_"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"augMat", ",", "augRhs"}], "}"}], ",", 
         RowBox[{
          RowBox[{"augMat", "=", "Lmat"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"augMat", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "=", 
           RowBox[{"vec", "[", 
            RowBox[{"IdentityMatrix", "[", "d", "]"}], "]"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{"Trace", " ", "constraint"}], "*)"}], 
          RowBox[{"augRhs", "=", "targetVec"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"augRhs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "=", "0"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"LinearSolve", "[", 
           RowBox[{"augMat", ",", "augRhs"}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"3.", " ", "Point"}], "-", 
        RowBox[{"wise", " ", "Physics", " ", "Calculator"}]}], "*)"}], 
      RowBox[{
       RowBox[{"getNumericalData", "[", "tVal_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "pVals", ",", "H", ",", "Lmat", ",", "rhoVec", ",", "rho", ",", 
           "dH", ",", "dLrho", ",", "drho", ",", "Ai", ",", "gMetric", ",", 
           "vel", ",", 
           RowBox[{"step", "=", 
            RowBox[{"10", "^", 
             RowBox[{"-", "5"}]}]}]}], "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{"Current", " ", "Path", " ", "Parameters"}], "*)"}], 
         RowBox[{
          RowBox[{"pVals", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"R", "*", 
               RowBox[{"Cos", "[", "tVal", "]"}]}], "+", 
              RowBox[{"offset", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{"R", "*", 
               RowBox[{"Sin", "[", "tVal", "]"}]}], "+", 
              RowBox[{"offset", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"vel", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "R"}], "*", 
              RowBox[{"Sin", "[", "tVal", "]"}]}], ",", 
             RowBox[{"R", "*", 
              RowBox[{"Cos", "[", "tVal", "]"}]}]}], "}"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{"d", 
            RowBox[{
             RowBox[{"(", "path", ")"}], "/", "dt"}]}], "*)"}], 
          RowBox[{"(*", 
           RowBox[{"Local", " ", "H", " ", "and", " ", "L"}], "*)"}], 
          RowBox[{"H", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"hamFunc", "@@", "pVals"}], ")"}], "/.", " ", 
            "rules"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Lmat", "=", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"vec", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "I"}], "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"H", ".", "b"}], "-", 
                   RowBox[{"b", ".", "H"}]}], ")"}]}], "+", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"dissFunc", "[", "b", "]"}], "@@", "pVals"}], 
                 ")"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"b", ",", "basis"}], "}"}]}], "]"}], "//", 
            RowBox[{"Transpose", "/.", " ", "rules"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Steady", " ", "State"}], "*)"}], 
          RowBox[{"rhoVec", "=", 
           RowBox[{
            RowBox[{"NullSpace", "[", "Lmat", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"rho", "=", 
           RowBox[{"unvec", "[", 
            RowBox[{"rhoVec", "/", 
             RowBox[{"Tr", "[", 
              RowBox[{"unvec", "[", "rhoVec", "]"}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "Derivatives", " ", "of", " ", "rho", " ", "via", " ", "Response",
              " ", 
             RowBox[{"Equation", ":", 
              RowBox[{"L", 
               RowBox[{"(", 
                RowBox[{"d_i", " ", "rho"}], ")"}]}]}]}], "=", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{"d_i", " ", "L"}], ")"}]}], 
             RowBox[{"(", "rho", ")"}]}]}], "*)"}], 
          RowBox[{"drho", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "pStep", ",", "Hstep", ",", "LmatStep", ",", "dLrhoVec"}], 
                "}"}], ",", 
               RowBox[{
                RowBox[{"pStep", "=", "pVals"}], ";", 
                RowBox[{
                 RowBox[{"pStep", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "+=", "step"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"Hstep", "=", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"hamFunc", "@@", "pStep"}], ")"}], "/.", " ", 
                  "rules"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"LmatStep", "=", 
                 RowBox[{
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"vec", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "I"}], "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Hstep", ".", "b"}], "-", 
                    RowBox[{"b", ".", "Hstep"}]}], ")"}]}], "+", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"dissFunc", "[", "b", "]"}], "@@", "pStep"}], 
                    ")"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"b", ",", "basis"}], "}"}]}], "]"}], "//", 
                  RowBox[{"Transpose", "/.", " ", "rules"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"dLrhoVec", "=", 
                 RowBox[{
                  RowBox[{"-", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"LmatStep", ".", "rhoVec"}], ")"}], "-", 
                    RowBox[{"(", 
                    RowBox[{"Lmat", ".", "rhoVec"}], ")"}]}], ")"}]}], "/", 
                  "step"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"unvec", "[", 
                 RowBox[{"solveLResponse", "[", 
                  RowBox[{"Lmat", ",", "dLrhoVec"}], "]"}], "]"}]}]}], "]"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "2"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"One", "-", 
             RowBox[{"Form", " ", "Ai"}]}], "=", 
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"H", ".", "d_i"}], " ", "rho"}], "]"}]}], "*)"}], 
          RowBox[{"Ai", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Re", "@", 
              RowBox[{"Tr", "[", 
               RowBox[{"H", ".", 
                RowBox[{"drho", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "2"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Friction", " ", "Metric", " ", "g_ij"}], "=", 
            RowBox[{"Tr", "[", 
             RowBox[{"d_i", " ", 
              RowBox[{"rho", ".", 
               RowBox[{"L", "^", 
                RowBox[{"-", "1"}]}]}], 
              RowBox[{"(", 
               RowBox[{"d_j", " ", "rho"}], ")"}]}], "]"}]}], "*)"}], 
          RowBox[{"(*", 
           RowBox[{"Note", ":", 
            RowBox[{"solveLResponse", " ", "acts", " ", "as", " ", 
             RowBox[{"L", "^", 
              RowBox[{"-", "1"}]}]}]}], "*)"}], 
          RowBox[{"gMetric", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Re", "@", 
              RowBox[{"Tr", "[", 
               RowBox[{
                RowBox[{"drho", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ".", 
                RowBox[{"unvec", "[", 
                 RowBox[{"solveLResponse", "[", 
                  RowBox[{"Lmat", ",", 
                   RowBox[{"vec", "[", 
                    RowBox[{"drho", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "]"}], "]"}]}], 
               "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Ai", ".", "vel"}], ",", 
            RowBox[{"vel", ".", "gMetric", ".", "vel"}]}], "}"}]}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "4.", " ", "Integration", " ", "over", " ", "the", " ", "Cycle"}], 
       "*)"}], 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Integrating cycle for d=\>\"", ",", "d", ",", 
        "\"\< system...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"gridData", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"getNumericalData", "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", 
           RowBox[{"Subdivide", "[", 
            RowBox[{"0", ",", 
             RowBox[{"2", " ", "Pi"}], ",", "points"}], "]"}]}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Simple", " ", "Trapezoidal", " ", "Integration"}], "*)"}], 
      RowBox[{"tStep", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "Pi"}], ")"}], "/", "points"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qGeo", "=", 
       RowBox[{"tStep", "*", 
        RowBox[{"Total", "[", 
         RowBox[{"gridData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"qDiss", "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "/", "tau"}], ")"}]}], "*", "tStep", "*", 
        RowBox[{"Total", "[", 
         RowBox[{"gridData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Result", " ", "Formatting"}], "*)"}], 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<--- Numerical Cycle Results (\[Tau] = \>\"", ",", "tau", ",", 
        "\"\<] ---\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Geometric Heat (Q_geo): \>\"", ",", "qGeo"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Dissipated Heat (Q_diss): \>\"", ",", "qDiss"}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Net Heat: \>\"", ",", 
        RowBox[{"qGeo", "+", "qDiss"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"qGeo", ",", "qDiss"}], "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.984148779806883*^9, 3.9841487959604826`*^9}, 
   3.9841488731128025`*^9, {3.984148907535269*^9, 3.984148970647788*^9}, {
   3.984149069333522*^9, 3.9841490978363066`*^9}, {3.9841491736485424`*^9, 
   3.984149217498787*^9}, {3.9841496580285625`*^9, 3.9841496719223423`*^9}, {
   3.9841502103162675`*^9, 3.984150276069581*^9}, 3.984150324757411*^9, {
   3.984150376515109*^9, 3.984150396395361*^9}, {3.984151721821909*^9, 
   3.9841517308304133`*^9}, 3.9845674069668922`*^9, 3.9863861671293964`*^9},
 CellLabel->
