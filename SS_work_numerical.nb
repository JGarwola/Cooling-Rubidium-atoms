Cell[CellGroupData[{

Cell["Liouvillian gap", "Subsection",
 CellChangeTimes->{{3.987869515546807*^9, 
  3.987869526159713*^9}},ExpressionUUID->"f1520594-8654-46df-9c40-\
373324315a99"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "LiouvillianGap", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LiouvillianGap", "[", 
    RowBox[{"hamFunc_", ",", "dissFunc_", ",", "params_", ",", "ranges_", ",", 
     RowBox[{"points_", ":", "25"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "d", ",", "d2", ",", "basis", ",", "vec", ",", "p1Range", ",", 
       "p2Range", ",", "data"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"1.", " ", "Setup", " ", "Dimensions"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Htest", "=", 
          RowBox[{"hamFunc", "@@", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ranges", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"ranges", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}]}]}], "}"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"d", "=", 
          RowBox[{"Length", "[", "Htest", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"d2", "=", 
          RowBox[{"d", "^", "2"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"basis", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"ReplacePart", "[", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", 
               RowBox[{"{", 
                RowBox[{"d", ",", "d"}], "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i", ",", "j"}], "}"}], "->", "1"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "d"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "d"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"vec", "[", "m_", "]"}], ":=", 
       RowBox[{"Flatten", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"2.", " ", "Grid", " ", "Setup"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"p1Range", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"ranges", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"ranges", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "3"}], "]"}], "]"}], ",", "points"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"p2Range", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"ranges", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"ranges", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "3"}], "]"}], "]"}], ",", "points"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<Computing Liouvillian Gap for \>\"", ",", "d", ",", "\"\<x\>\"", 
        ",", "d", ",", "\"\< system...\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"data", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "H", ",", "Lmat", ",", "evals", ",", "sortedReals", ",", "gap"}], 
            "}"}], ",", 
           RowBox[{
            RowBox[{"H", "=", 
             RowBox[{"hamFunc", "[", 
              RowBox[{"p1", ",", "p2"}], "]"}]}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Construct", " ", "full", " ", "Liouvillian", " ", "matrix"}], 
             "*)"}], 
            RowBox[{"Lmat", "=", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"vec", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "I"}], "*", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"H", ".", "b"}], "-", 
                    RowBox[{"b", ".", "H"}]}], ")"}]}], "+", 
                  RowBox[{
                   RowBox[{"dissFunc", "[", "b", "]"}], "[", 
                   RowBox[{"p1", ",", "p2"}], "]"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"b", ",", "basis"}], "}"}]}], "]"}], "//", 
              "Transpose"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Get", " ", "all", " ", "eigenvalues"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"evals", "=", 
             RowBox[{"Eigenvalues", "[", "Lmat", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "Sort", " ", "the", " ", "real", " ", "parts", " ", "in", " ", 
              "descending", " ", "order"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"The", " ", "first", " ", "should", " ", 
              RowBox[{"be", "~", "0"}], " ", 
              RowBox[{"(", 
               RowBox[{"steady", " ", "state"}], ")"}]}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "The", " ", "second", " ", "is", " ", "the", " ", "one", " ", 
              "that", " ", "defines", " ", "the", " ", "gap"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"sortedReals", "=", 
             RowBox[{"Sort", "[", 
              RowBox[{
               RowBox[{"Re", "[", "evals", "]"}], ",", "Greater"}], "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "We", " ", "take", " ", "the", " ", "absolute", " ", "value", 
              " ", "of", " ", "the", " ", "2", "nd", " ", "largest", " ", 
              "real", " ", "part"}], "*)"}], 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
              "We", " ", "use", " ", "Max", " ", "to", " ", "avoid", " ", 
               "picking", " ", "the", " ", "zero"}], "-", 
              RowBox[{
              "eigenvalue", " ", "itself", " ", "due", " ", "to", " ", 
               "noise"}]}], "*)"}], 
            RowBox[{"gap", "=", 
             RowBox[{"Abs", "[", 
              RowBox[{"sortedReals", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"p2", ",", "p1", ",", "gap"}], "}"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"p1", ",", "p1Range"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"p2", ",", "p2Range"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"3.", " ", "Visualization"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ListContourPlot", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"data", ",", "1"}], "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"InterpolationOrder", "->", "3"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"BarLegend", "[", 
          RowBox[{"Automatic", ",", 
           RowBox[{"LegendLabel", "->", "\"\<Gap (MHz)\>\""}]}], "]"}]}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"params", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"params", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotLabel", "->", "\"\<Liouvillian Spectral Gap\>\""}]}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.987088738491934*^9, 3.987088738491934*^9}, {
  3.9870888248365326`*^9, 3.987088830306229*^9}, {3.987088860397995*^9, 
  3.9870888628286896`*^9}, {3.9878695290400105`*^9, 3.9878695916888695`*^9}, {
  3.9881179570591354`*^9, 3.98811795866615*^9}},
 CellLabel->
  "In[400]:=",ExpressionUUID->"cb57ef45-e6dd-4fea-82d3-a1035146e59e"]
}, Closed]],

Cell[CellGroupData[{

Cell["Reversible and dissipative heat", "Subsection",
 CellChangeTimes->{{3.9841486952878156`*^9, 3.9841487733651824`*^9}, {
  3.9841502801597147`*^9, 3.9841502851820345`*^9}, {3.9864632233991528`*^9, 
  3.986463224732639*^9}, {3.9870858732430515`*^9, 3.987085874237616*^9}, {
