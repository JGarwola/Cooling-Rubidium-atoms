        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"-", "I"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "I", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gm", "[", "8", "]"}], "=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", "3", "]"}]}], "*", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          RowBox[{"-", "2"}]}], "}"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"id", "=", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "a", " ", "helper", " ", "function", " ", "for", " ", 
     "the", " ", "Lindblad", " ", "Dissipator"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LindbladDissipator", "[", 
     RowBox[{"L_", ",", "p_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"L", ".", "p", ".", 
      RowBox[{"ConjugateTranspose", "[", "L", "]"}]}], "-", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", "L", "]"}], ".", "L", ".", "p"}], 
        "+", 
        RowBox[{"p", ".", 
         RowBox[{"ConjugateTranspose", "[", "L", "]"}], ".", "L"}]}], 
       ")"}]}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Define", " ", "Bose"}], "-", 
     RowBox[{"Einstein", " ", "distribution"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"We", " ", "set", " ", "hbar"}], "=", 
     RowBox[{"kB", "=", 
      RowBox[{"1", " ", "for", " ", "symbolic", " ", "simplicity"}]}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"nBE", "[", 
      RowBox[{"omega_", ",", "T_"}], "]"}], ":=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"omega", "/", "T"}], "]"}], "-", "1"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "NumericalHeatCurvature", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"NumericalHeatCurvature", "[", 
      RowBox[{
      "hamFunc_", ",", "dissFunc_", ",", "params_", ",", "ranges_", ",", 
       RowBox[{"points_", ":", "25"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Htest", ",", "d", ",", "dSquared", ",", "basis", ",", "vec", ",", 
         "unvec", ",", "solveResponse", ",", "p1Range", ",", "p2Range", ",", 
         "step", ",", "data"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "1.", " ", "Dynamically", " ", "detect", " ", "Hilbert", " ", "space",
          " ", "dimension"}], "*)"}], 
       RowBox[{
        RowBox[{"Htest", "=", 
         RowBox[{"hamFunc", "@@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ranges", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{"ranges", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"d", "=", 
         RowBox[{"Length", "[", "Htest", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dSquared", "=", 
         RowBox[{"d", "^", "2"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "2.", " ", "Generalized", " ", "Basis", " ", "for", " ", "d", " ", 
          "x", " ", "d", " ", "operators"}], "*)"}], 
        RowBox[{"basis", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"ReplacePart", "[", 
              RowBox[{
               RowBox[{"ConstantArray", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"{", 
                  RowBox[{"d", ",", "d"}], "}"}]}], "]"}], ",", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"i", ",", "j"}], "}"}], "->", "1"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "d"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "d"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"vec", "[", "m_", "]"}], ":=", 
         RowBox[{"Flatten", "[", "m", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"unvec", "[", "v_", "]"}], ":=", 
         RowBox[{"Partition", "[", 
          RowBox[{"v", ",", "d"}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"Matches", " ", "the", " ", "detected", " ", "dimension"}], 
         "*)"}], 
        RowBox[{"(*", 
         RowBox[{"3.", " ", "Linear", " ", "Response", " ", "Solver"}], 
         "*)"}], 
        RowBox[{
         RowBox[{"solveResponse", "[", 
          RowBox[{"Lmat_", ",", "rhsVec_"}], "]"}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"augmentedMat", ",", "augmentedRhs"}], "}"}], ",", 
           RowBox[{
            RowBox[{"augmentedMat", "=", "Lmat"}], ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"augmentedMat", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "=", 
             RowBox[{"vec", "[", 
              RowBox[{"IdentityMatrix", "[", "d", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"augmentedRhs", "=", "rhsVec"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"augmentedRhs", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "=", "0"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"LinearSolve", "[", 
             RowBox[{"augmentedMat", ",", "augmentedRhs"}], "]"}]}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"4.", " ", "Calculation", " ", "Loop"}], "*)"}], 
        RowBox[{"p1Range", "=", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"ranges", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"ranges", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "3"}], "]"}], "]"}], ",", "points"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"p2Range", "=", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"ranges", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"ranges", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "3"}], "]"}], "]"}], ",", "points"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"step", "=", 
         RowBox[{"10", "^", 
          RowBox[{"-", "5"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", "\"\<Computing 6x6 Numerical Curvature Grid...\>\"", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"data", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "H", ",", "Lmat", ",", "rhoVec", ",", "dH1", ",", "dH2", ",", 
               "dLrho1", ",", "dLrho2", ",", "drho1", ",", "drho2", ",", 
               "rho"}], "}"}], ",", 
             RowBox[{
              RowBox[{"H", "=", 
               RowBox[{"hamFunc", "[", 
                RowBox[{"p1", ",", "p2"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Generate", " ", "Liouvillian", " ", "Matrix", " ", "for", " ",
                 "the", " ", "full", " ", 
                RowBox[{"d", "^", "2"}], " ", "space"}], "*)"}], 
              RowBox[{"Lmat", "=", 
               RowBox[{
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"vec", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"-", "I"}], "*", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"H", ".", "b"}], "-", 
                    RowBox[{"b", ".", "H"}]}], ")"}]}], "+", 
                    RowBox[{
                    RowBox[{"dissFunc", "[", "b", "]"}], "[", 
                    RowBox[{"p1", ",", "p2"}], "]"}]}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"b", ",", "basis"}], "}"}]}], "]"}], "//", 
                "Transpose"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"rhoVec", "=", 
               RowBox[{
                RowBox[{"NullSpace", "[", "Lmat", "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"rho", "=", 
               RowBox[{"unvec", "[", 
                RowBox[{"rhoVec", "/", 
                 RowBox[{"Tr", "[", 
                  RowBox[{"unvec", "[", "rhoVec", "]"}], "]"}]}], "]"}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"dH1", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"hamFunc", "[", 
                   RowBox[{
                    RowBox[{"p1", "+", "step"}], ",", "p2"}], "]"}], "-", 
                  "H"}], ")"}], "/", "step"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"dH2", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"hamFunc", "[", 
                   RowBox[{"p1", ",", 
                    RowBox[{"p2", "+", "step"}]}], "]"}], "-", "H"}], ")"}], 
                "/", "step"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"dLrho1", "=", 
               RowBox[{"-", 
                RowBox[{"vec", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "I"}], "*", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"dH1", ".", "rho"}], "-", 
                    RowBox[{"rho", ".", "dH1"}]}], ")"}]}], "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"dissFunc", "[", "rho", "]"}], "[", 
                    RowBox[{
                    RowBox[{"p1", "+", "step"}], ",", "p2"}], "]"}], "-", 
                    RowBox[{
                    RowBox[{"dissFunc", "[", "rho", "]"}], "[", 
                    RowBox[{"p1", ",", "p2"}], "]"}]}], ")"}], "/", 
                   "step"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"dLrho2", "=", 
               RowBox[{"-", 
                RowBox[{"vec", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "I"}], "*", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"dH2", ".", "rho"}], "-", 
                    RowBox[{"rho", ".", "dH2"}]}], ")"}]}], "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"dissFunc", "[", "rho", "]"}], "[", 
                    RowBox[{"p1", ",", 
                    RowBox[{"p2", "+", "step"}]}], "]"}], "-", 
                    RowBox[{
                    RowBox[{"dissFunc", "[", "rho", "]"}], "[", 
                    RowBox[{"p1", ",", "p2"}], "]"}]}], ")"}], "/", 
                   "step"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"drho1", "=", 
               RowBox[{"unvec", "[", 
                RowBox[{"solveResponse", "[", 
                 RowBox[{"Lmat", ",", "dLrho1"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"drho2", "=", 
               RowBox[{"unvec", "[", 
                RowBox[{"solveResponse", "[", 
                 RowBox[{"Lmat", ",", "dLrho2"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"p2", ",", "p1", ",", 
                RowBox[{"Re", "@", 
                 RowBox[{"Tr", "[", 
                  RowBox[{
                   RowBox[{"dH1", ".", "drho2"}], "-", 
                   RowBox[{"dH2", ".", "drho1"}]}], "]"}]}]}], "}"}]}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"p1", ",", "p1Range"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"p2", ",", "p2Range"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ListContourPlot", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"data", ",", "1"}], "]"}], ",", 
          RowBox[{"InterpolationOrder", "->", "3"}], ",", 
          RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
          RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"params", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"params", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ",", 
          RowBox[{
          "PlotLabel", "->", "\"\<6x6 Spin-Motion Heat Curvature\>\""}]}], 
         "]"}]}]}], "]"}]}], ";"}]}]}]], "Input",
